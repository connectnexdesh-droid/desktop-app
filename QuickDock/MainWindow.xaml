<Window x:Class="QuickDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickDock" Height="780" Width="1160"
        MinHeight="650" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220" Foreground="#F0F4FB"
        StateChanged="MainWindow_StateChanged">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111C2E" CornerRadius="14" Padding="18" Margin="0,0,0,16"
                BorderBrush="#293D58" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="QuickDock" FontSize="27" FontWeight="Bold" Foreground="#F3F7FF"/>
                    <TextBlock Text="Your quick-copy, internal paste and 2FA workspace"
                               Foreground="#A6B4C8" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1B2B43" CornerRadius="9" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#37C991" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="LOCAL DATA" FontSize="11" FontWeight="Bold" Foreground="#D6E3F5"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Background="#111C2E" Foreground="#F0F4FB"
                    BorderBrush="#31445F" BorderThickness="1">
            <TabItem Header="TXT SHEETS">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock Text="Select sheet" Foreground="#A6B4C8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox x:Name="TxtSheetSelector" Width="150" SelectedIndex="0"
                                  SelectionChanged="TxtSheetSelector_SelectionChanged"
                                  Background="#111C2E" Foreground="#F0F4FB"
                                  BorderBrush="#405675" Padding="8">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ComboBoxItem}">
                                    <Setter Property="Background" Value="#111C2E"/>
                                    <Setter Property="Foreground" Value="#F0F4FB"/>
                                    <Setter Property="Padding" Value="9,7"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter Property="Background" Value="#263F61"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#315F94"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBoxItem Content="TXT 1" Tag="TXT1"/>
                            <ComboBoxItem Content="TXT 2" Tag="TXT2"/>
                            <ComboBoxItem Content="TXT 3" Tag="TXT3"/>
                            <ComboBoxItem Content="TXT 4" Tag="TXT4"/>
                        </ComboBox>
                        <TextBlock Text="Use Ctrl or Shift to select multiple rows. Delete removes all selected rows."
                                   Foreground="#A6B4C8" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </DockPanel>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,10,0,0">
                        <Button x:Name="Txt1CopyButton" Content="TXT 1" Click="Txt1_Main_Click"
                                Height="46" Background="#244D78" BorderBrush="#4A79AA"/>
                        <Button x:Name="Txt2CopyButton" Content="TXT 2" Click="Txt2_Main_Click"
                                Height="46" Background="#244D78" BorderBrush="#4A79AA"/>
                        <Button x:Name="Txt3CopyButton" Content="TXT 3" Click="Txt3_Main_Click"
                                Height="46" Background="#244D78" BorderBrush="#4A79AA"/>
                        <Button x:Name="Txt4CopyButton" Content="TXT 4" Click="Txt4_Main_Click"
                                Height="46" Background="#244D78" BorderBrush="#4A79AA"/>
                    </UniformGrid>

                    <DataGrid x:Name="TextGrid" Grid.Row="2" ItemsSource="{Binding CurrentTextRows}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                              PreviewKeyDown="TextGrid_PreviewKeyDown"
                              CellEditEnding="TextGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="70" IsReadOnly="True"
                                                ElementStyle="{StaticResource GridTextStyle}"/>
                            <DataGridTextColumn Header="TEXT" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                ElementStyle="{StaticResource GridTextStyle}"
                                                EditingElementStyle="{StaticResource GridEditTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Export TXT CSV" Click="ExportTextCsv_Click" Background="#235B52" BorderBrush="#3B907F"/>
                        <Button Content="+ Add row" Click="AddTextRow_Click" Background="#244D78" BorderBrush="#4A79AA"/>
                        <Button Content="Select all" Click="TextGrid_SelectAll_Click" Background="#263B5B"/>
                        <Button Content="Delete selected" Click="DeleteTextRow_Click" Background="#713A49" BorderBrush="#A85B6C"/>
                        <Button Content="Undo" Click="Undo_Click" Background="#34445D"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem Header="A–E SHEET">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Combined internal paste sheet" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="Select multiple cells with Ctrl or drag. Delete selected rows removes every row containing a selected cell. Each A–E button fills the next empty cell in its own column."
                                   Foreground="#A6B4C8" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <UniformGrid Columns="5" Margin="0,10,0,0">
                            <Button x:Name="MainAButton" Content="A" Click="MainA_Click" Height="48" Background="#263B5B"/>
                            <Button x:Name="MainBButton" Content="B" Click="MainB_Click" Height="48" Background="#263B5B"/>
                            <Button x:Name="MainCButton" Content="C" Click="MainC_Click" Height="48" Background="#263B5B"/>
                            <Button x:Name="MainDButton" Content="D" Click="MainD_Click" Height="48" Background="#263B5B"/>
                            <Button x:Name="MainEButton" Content="E" Click="MainE_Click" Height="48" Background="#263B5B"/>
                        </UniformGrid>
                    </StackPanel>
                    <DataGrid x:Name="MainGrid" Grid.Row="1" ItemsSource="{Binding MainRows}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Extended" SelectionUnit="Cell" HeadersVisibility="Column"
                              PreviewKeyDown="MainGrid_PreviewKeyDown"
                              CellEditEnding="MainGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ROW" Binding="{Binding RowNumber}" Width="70" IsReadOnly="True"
                                                ElementStyle="{StaticResource GridTextStyle}"/>
                            <DataGridTextColumn Header="A" Binding="{Binding A, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                ElementStyle="{StaticResource GridTextStyle}" EditingElementStyle="{StaticResource GridEditTextStyle}"/>
                            <DataGridTextColumn Header="B" Binding="{Binding B, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                ElementStyle="{StaticResource GridTextStyle}" EditingElementStyle="{StaticResource GridEditTextStyle}"/>
                            <DataGridTextColumn Header="C" Binding="{Binding C, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                ElementStyle="{StaticResource GridTextStyle}" EditingElementStyle="{StaticResource GridEditTextStyle}"/>
                            <DataGridTextColumn Header="D" Binding="{Binding D, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                ElementStyle="{StaticResource GridTextStyle}" EditingElementStyle="{StaticResource GridEditTextStyle}"/>
                            <DataGridTextColumn Header="E" Binding="{Binding E, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                ElementStyle="{StaticResource GridTextStyle}" EditingElementStyle="{StaticResource GridEditTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="+ Add 20 rows" Click="AddMainRows_Click" Background="#244D78" BorderBrush="#4A79AA"/>
                        <Button Content="Select all" Click="MainGrid_SelectAll_Click" Background="#263B5B"/>
                        <Button Content="Clear selected cells" Click="ClearSelectedCells_Click" Background="#755A2B" BorderBrush="#A98A4B"/>
                        <Button Content="Delete selected rows" Click="DeleteMainRows_Click" Background="#713A49" BorderBrush="#A85B6C"/>
                        <Button Content="Undo" Click="Undo_Click" Background="#34445D"/>
                        <Button Content="Export A–E CSV" Click="ExportMainCsv_Click" Background="#235B52" BorderBrush="#3B907F"/>
                        <Button Content="Save sheet" Click="SaveMainRows_Click" Background="#1E674F" BorderBrush="#329B77"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem Header="SETTINGS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Floating panel controls" FontSize="21" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="Turn the entire floating panel on or off, then choose exactly which actions should appear inside it."
                                   Foreground="#A6B4C8" TextWrapping="Wrap" Margin="0,0,0,18"/>

                        <Border Background="#1B2B43" CornerRadius="10" Padding="16" Margin="0,0,0,18"
                                BorderBrush="#344D70" BorderThickness="1">
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="Floating Bubble" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="Master switch for the always-on-top floating panel."
                                               Foreground="#A6B4C8" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Settings.FloatingEnabled, Mode=TwoWay}"
                                          Checked="SettingChanged" Unchecked="SettingChanged"
                                          VerticalAlignment="Center" Content="Enabled" FontWeight="Bold"/>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="QUICK COPY BUTTONS" Foreground="#8BB8FF" FontWeight="Bold" Margin="0,0,0,6"/>
                        <UniformGrid Columns="2" Margin="0,0,0,18">
                            <CheckBox Content="TXT 1" IsChecked="{Binding Settings.Txt1Enabled, Mode=TwoWay}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                            <CheckBox Content="TXT 2" IsChecked="{Binding Settings.Txt2Enabled, Mode=TwoWay}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                            <CheckBox Content="TXT 3" IsChecked="{Binding Settings.Txt3Enabled, Mode=TwoWay}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                            <CheckBox Content="TXT 4" IsChecked="{Binding Settings.Txt4Enabled, Mode=TwoWay}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                            <CheckBox Content="2FA Generator" IsChecked="{Binding Settings.TwoFaEnabled, Mode=TwoWay}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                        </UniformGrid>

                        <TextBlock Text="QUICK PASTE BUTTONS" Foreground="#8BB8FF" FontWeight="Bold" Margin="0,0,0,6"/>
                        <UniformGrid Columns="5" Margin="0,0,0,18">
                            <CheckBox Content="A" IsChecked="{Binding Settings.AEnabled, Mode=TwoWay}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                            <CheckBox Content="B" IsChecked="{Binding Settings.BEnabled, Mode=TwoWay}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                            <CheckBox Content="C" IsChecked="{Binding Settings.CEnabled, Mode=TwoWay}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                            <CheckBox Content="D" IsChecked="{Binding Settings.DEnabled, Mode=TwoWay}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                            <CheckBox Content="E" IsChecked="{Binding Settings.EEnabled, Mode=TwoWay}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                        </UniformGrid>

                        <Border Background="#111C2E" CornerRadius="10" Padding="14" BorderBrush="#31445F" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="How the buttons work" FontWeight="SemiBold"/>
                                <TextBlock Text="TXT: a single click copies the next non-empty row. Double-click within the Windows double-click interval to copy the previous non-empty row."
                                           Foreground="#A6B4C8" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="A–E: copies the current Windows clipboard text into the next empty cell of the selected column in this app's internal sheet."
                                           Foreground="#A6B4C8" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="2FA: reads a Base32 secret or otpauth:// URI from the clipboard, generates a 6-digit TOTP code and replaces the clipboard with that code."
                                           Foreground="#A6B4C8" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#111C2E" CornerRadius="8" Padding="10,7" Margin="0,12,0,0"
                BorderBrush="#293D58" BorderThickness="1">
            <TextBlock x:Name="StatusLabel" Text="Ready — your data is stored locally on this PC."
                       Foreground="#A6B4C8" FontSize="12"/>
        </Border>
    </Grid>
</Window>
