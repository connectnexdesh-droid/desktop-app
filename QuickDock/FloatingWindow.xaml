<Window x:Class="QuickDock.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickDock Floating Panel"
        Width="90" Height="90"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Border x:Name="BubbleRoot" Width="90" Height="90"
                CornerRadius="45" Background="#2456A6"
                BorderBrush="#9BC5FF" BorderThickness="2"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                MouseLeftButtonDown="Bubble_MouseLeftButtonDown"
                MouseMove="Bubble_MouseMove"
                MouseLeftButtonUp="Bubble_MouseLeftButtonUp"
                Cursor="Hand" SnapsToDevicePixels="True">
            <Grid Margin="5">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="QD" FontSize="20" FontWeight="Bold"
                               Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="BubbleStatusText" Text="TXT: —" FontSize="9"
                               FontWeight="SemiBold" Foreground="#EAF3FF"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
                <Ellipse Width="10" Height="10" Fill="#37C991"
                         Stroke="#10213A" StrokeThickness="2"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,1,1"/>
            </Grid>
        </Border>

        <Border x:Name="PanelRoot" Width="370" Height="500"
                CornerRadius="16" Background="#0E192B"
                BorderBrush="#49688F" BorderThickness="1"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="Collapsed" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,14"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown"
                      Cursor="SizeAll">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="QuickDock" FontSize="20" FontWeight="Bold" Foreground="#F4F7FC"/>
                        <TextBlock Text="FLOATING QUICK ACTIONS" FontSize="9" Foreground="#A6B4C8" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="—" Width="34" Height="32"
                            Padding="0" Margin="0" Click="Collapse_Click"
                            Background="#263B5B" ToolTip="Collapse to bubble"/>
                </Grid>

                <TextBlock Grid.Row="1" Text="QUICK COPY · DOUBLE-CLICK FOR PREVIOUS"
                           FontSize="10" FontWeight="Bold" Foreground="#8BB8FF"
                           Margin="2,0,0,6"/>
                <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,12">
                    <Button x:Name="Txt1Button" Content="TXT 1" Click="Txt1_Click"
                            Height="50" Padding="5,3" FontSize="11"
                            Background="#24466F" BorderBrush="#4D79AA"/>
                    <Button x:Name="Txt2Button" Content="TXT 2" Click="Txt2_Click"
                            Height="50" Padding="5,3" FontSize="11"
                            Background="#24466F" BorderBrush="#4D79AA"/>
                    <Button x:Name="Txt3Button" Content="TXT 3" Click="Txt3_Click"
                            Height="50" Padding="5,3" FontSize="11"
                            Background="#24466F" BorderBrush="#4D79AA"/>
                    <Button x:Name="Txt4Button" Content="TXT 4" Click="Txt4_Click"
                            Height="50" Padding="5,3" FontSize="11"
                            Background="#24466F" BorderBrush="#4D79AA"/>
                </UniformGrid>

                <Button x:Name="TwoFaButton" Grid.Row="3" Content="◈   GENERATE 2FA CODE"
                        Click="TwoFa_Click" Height="44" Margin="3,0,3,14"
                        Background="#17664F" BorderBrush="#35A27F"/>

                <StackPanel Grid.Row="4">
                    <TextBlock Text="A–E · LAST USED CELL" FontSize="10"
                               FontWeight="Bold" Foreground="#8BB8FF" Margin="2,0,0,6"/>
                    <UniformGrid Columns="5" Margin="0,0,0,10">
                        <Button x:Name="AButton" Content="A" Click="A_Click" FontSize="12"
                                Height="54" Padding="3" Background="#263B5B" BorderBrush="#49688F"/>
                        <Button x:Name="BButton" Content="B" Click="B_Click" FontSize="12"
                                Height="54" Padding="3" Background="#263B5B" BorderBrush="#49688F"/>
                        <Button x:Name="CButton" Content="C" Click="C_Click" FontSize="12"
                                Height="54" Padding="3" Background="#263B5B" BorderBrush="#49688F"/>
                        <Button x:Name="DButton" Content="D" Click="D_Click" FontSize="12"
                                Height="54" Padding="3" Background="#263B5B" BorderBrush="#49688F"/>
                        <Button x:Name="EButton" Content="E" Click="E_Click" FontSize="12"
                                Height="54" Padding="3" Background="#263B5B" BorderBrush="#49688F"/>
                    </UniformGrid>
                    <Border Background="#17243A" BorderBrush="#314A69" BorderThickness="1" CornerRadius="9" Padding="11">
                        <TextBlock Text="Each A–E action reads the Windows clipboard and fills the next empty cell in that column."
                                   Foreground="#C1CEE0" FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock x:Name="EmptyState" Text="All action buttons are disabled. Enable buttons in Settings."
                               Foreground="#C1CEE0" FontSize="11" TextWrapping="Wrap"
                               Margin="4,12,4,0" Visibility="Collapsed"/>
                </StackPanel>

                <TextBlock Grid.Row="5" Text="Drag the bubble to move · Drag this title bar to move the panel"
                           Foreground="#8799B2" FontSize="9" TextAlignment="Center" Margin="0,8,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
